{{ 'lookbook.css' | asset_url | stylesheet_tag }}

<div class="lookbook-section color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="lookbook-section__heading {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.lookbook != blank %}
      <div
        data-lookbook-root
        data-lookbook-config='{
          "mode": "fixed",
          "lookbookHandle": {{ section.settings.lookbook.system.handle | json }},
          "shopDomain": {{ shop.permanent_domain | json }},
          "storefrontAccessToken": {{ settings.lookbook_storefront_token | json }},
          "apiVersion": {{ settings.lookbook_api_version | json }},
          "countryCode": {{ localization.country.iso_code | json }},
          "columns": {{ section.settings.columns | json }}
        }'
      >
        <p class="lookbook-section__placeholder">Loading lookbook…</p>
      </div>
    {% elsif request.design_mode %}
      <p class="lookbook-section__empty-state">
        Select a lookbook above to display it here.
      </p>
    {% endif %}
  </div>
</div>

{{ 'lookbook.js' | asset_url | script_tag }}

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Lookbook",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the look"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" }
      ],
      "default": "h2"
    },
    {
      "type": "metaobject",
      "id": "lookbook",
      "label": "Lookbook",
      "metaobject_type": "lookbook",
      "info": "Choose which lookbook to display on the homepage."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Products per row (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Lookbook"
    }
  ]
}
{% endschema %}